PORT=8787

# Agent / ChatGPT API key.
API_KEY=

# Optional separate key for /manager/v1. When set, API_KEY is not accepted
# on the Manager API surface.
MANAGER_API_KEY=

SLSKD_URL=http://slskd:5030
SLSKD_API_VERSION=v0
SLSKD_API_KEY=

# Host directory mounted read-only by compose.yaml. It should contain
# transfers.db and messaging.db from slskd.
SLSKD_DATA_PATH=/path/to/slskd/data/data
SLSKD_TRANSFERS_DB_PATH=/slskd-data/transfers.db
SLSKD_MESSAGING_DB_PATH=/slskd-data/messaging.db

NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
NAVIDROME_CLIENT_NAME=music-api
NAVIDROME_API_VERSION=1.16.1

MUSICBRAINZ_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_USER_AGENT=MeepMusicAutomation/1.0 (contact@example.com)

DATABASE_PATH=/app/data/music-api.sqlite

SEARCH_COLLECTION_MS=7000
SEARCH_RESULT_TTL_MINUTES=60

CATALOG_CACHE_HOURS=24
ARTIST_CACHE_DAYS=30
LIBRARY_CACHE_MINUTES=10
LIBRARY_SNAPSHOT_TTL_HOURS=24
LIBRARY_MUSIC_PATH=/music

# Optional Gradient Radio local acoustic-neighbor provider. When enabled,
# music-api uses an incrementally maintained `simil` Discogs-EffNet index and
# persists raw-cosine local neighbors in recording_similarity_edges. `simil`
# must be available inside the music-api runtime and see the same /music mount.
GRADIENT_SIMIL_ENABLED=false
GRADIENT_SIMIL_COMMAND=simil
GRADIENT_SIMIL_LIBRARY=gradient
GRADIENT_SIMIL_WORKERS=2
GRADIENT_SIMIL_MIN_COSINE=0.22

DEFAULT_MAX_CANDIDATES=10
MAX_SEARCH_CANDIDATES=20

MAX_CONCURRENT_SOULSEEK_SEARCHES=2
MAX_CONCURRENT_NAVIDROME_REQUESTS=5

LASTFM_API_KEY=
LASTFM_USERNAME=SatanReloaded

LISTENBRAINZ_USERNAME=
LISTENBRAINZ_TOKEN=

RECOMMENDATION_SEEDS_PER_WINDOW=25
RECOMMENDATION_MAX_SEEDS=60
RECOMMENDATION_SIMILAR_PER_SEED=20
RECOMMENDATION_DEFAULT_LIMIT=50
RECOMMENDATION_NEW_RELEASE_DAYS=180

RECOMMENDATION_WEIGHT_EXTERNAL=0.35
RECOMMENDATION_WEIGHT_SEED_AFFINITY=0.25
RECOMMENDATION_WEIGHT_CONSENSUS=0.15
RECOMMENDATION_WEIGHT_RECENCY=0.10
RECOMMENDATION_WEIGHT_NOVELTY=0.10
RECOMMENDATION_WEIGHT_POPULARITY=0.05

RECOMMENDATION_MAX_PER_SEED=3
RECOMMENDATION_MAX_RELEASES_PER_ARTIST=2
RECOMMENDATION_WILDCARD_RATIO=0.10
RECOMMENDATION_REPEAT_COOLDOWN_DAYS=30
